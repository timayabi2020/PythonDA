   "source": [
    "num = int(input(\"Enter a number\"))\n",
    "is_duck_number = False\n",
    "if str(num)[0] != '0':\n",
    "    while num != 0:\n",
    "        digit = num % 10\n",
    "        if digit == 0:\n",
    "            is_duck_number = True\n",
    "            break\n",
    "        num = num // 10\n",
    "\n",
    "print(f\"{is_duck_number}\")"
   ]
