   "source": [
    "num = int(input(\"Enter a number\"))\n",
    "\n",
    "if num <= 0:\n",
    "    print(num, ' is invalid')\n",
    "else:\n",
    "    if num % 2 == 0:\n",
    "        print(num, \" is even\")\n",
    "    else:\n",
    "        print(num, \" is odd\")"
